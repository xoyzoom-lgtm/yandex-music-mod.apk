    <!-- О программе -->
    <string name="about_title">О программе</string>
    <string name="about_version">Версия %1$s</string>
    <string name="about_description">Неофициальный Android-клиент Яндекс Музыки с функциями мода: Discord, Last.fm, тексты LRCLIB, шрифты, масштаб, высокое качество по умолчанию.</string>
    <string name="about_based_on_title">Основано на проектах</string>
    <string name="about_based_on">Идеи и часть логики взяты из десктопных модов Vzlomhik2005/Yandex-Music-Mod и PulseSync-mod (оба — лицензия MIT) и переделаны под Android. Код PulseSync-mod не копировался.</string>
    <string name="about_original_repo">Открыть оригинальный репозиторий</string>
    <string name="about_pulsesync_repo">Открыть PulseSync-mod</string>
    <string name="about_this_repo">Открыть репозиторий Android-версии</string>
    <string name="about_disclaimer_title">Важно</string>
    <string name="about_disclaimer">Приложение не связано с ООО «Яндекс», Discord Inc. и Last.fm. Оно открывает официальную веб-версию Яндекс Музыки: вход выполняется через Яндекс ID, а качество звука, реклама и доступ к трекам определяются вашей подпиской. Обхода Яндекс Плюса и скачивания треков нет.</string>
    <string name="about_licenses_title">Лицензии</string>
    <string name="about_license_this">Лицензия этого приложения (MIT)</string>
    <string name="about_license_original">Лицензия оригинального проекта (MIT)</string>

